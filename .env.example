# Copier ce fichier en .env.local puis adapter les valeurs.
# Ces variables n'ont PAS le préfixe NEXT_PUBLIC_ : elles restent côté serveur,
# ce qui est voulu puisque tous les appels à Strapi se font dans des Server Components.

# URL du back-office Strapi (sans slash final)
STRAPI_URL=http://localhost:1337

# Optionnel : token API créé dans Strapi (Settings > API Tokens, type "Read-only").
# Sans token, il faut autoriser find/findOne pour le rôle "Public"
# (Settings > Users & Permissions > Roles > Public).
STRAPI_API_TOKEN=
